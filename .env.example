# =========================================
# kr-ai-trader 환경 변수 템플릿
# 이 파일을 .env 로 복사 후 값 채우기. .env 는 절대 커밋 금지.
# =========================================

# ---------- 운영 모드 ----------
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO

# ---------- LLM 백엔드 선택 ----------
# anthropic_api | openai_api | claude_code_cli | codex_cli | ollama
LLM_PROVIDER=claude_code_cli

# Anthropic Claude API (LLM_PROVIDER=anthropic_api)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI / Codex API (LLM_PROVIDER=openai_api)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Claude Code CLI (LLM_PROVIDER=claude_code_cli) — API 키 불필요
# `claude` 로 사전 로그인된 OAuth 세션 사용
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=claude-sonnet-4-6

# Codex CLI (LLM_PROVIDER=codex_cli) — API 키 불필요
CODEX_BIN=codex
CODEX_MODEL=gpt-5

# Ollama 로컬 (LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# ---------- KIS Open API ----------
# https://apiportal.koreainvestment.com/ 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=          # 8자리-2자리, 예: 12345678-01
KIS_LIVE=0                   # 0=모의투자, 1=실계좌 (실계좌는 충분한 검증 후)

# ---------- 리스크 파라미터 ----------
MAX_POSITION_PCT=3.0         # 종목당 최대 비중 %
MAX_SECTOR_PCT=30.0          # 섹터당 최대 비중 %
DAILY_LOSS_HALT_PCT=2.0      # 일일 손실 도달 시 신규진입 중단
DAILY_LOSS_FLATTEN_PCT=4.0   # 일일 손실 도달 시 전량청산
HARD_STOP_PCT=7.0            # 종목별 하드 손절
LEVERAGE=0                   # v1 은 0 고정

# ---------- 유니버스 ----------
UNIVERSE=kospi200            # kospi200 | kosdaq150 | custom
UNIVERSE_FILE=               # custom 일 때 ticker 목록 파일 경로

# ---------- 알람 ----------
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- 운영 안전장치 ----------
HALT_FILE=/tmp/kr-ai-trader.HALT  # 이 파일 존재 시 모든 신규주문 중단
RECONCILIATION_INTERVAL_SEC=60
